rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra para a coleção de hábitos (HabitFlow)
    // Garante que cada usuário acesse e modifique estritamente apenas seus próprios dados
    match /habits/{habitId} {
      // Leitura permitida apenas se o usuário estiver autenticado e for dono do registro
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Criação permitida apenas se o userId no documento coincidir com o UID autenticado
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Atualização e exclusão permitidas apenas para o próprio dono do registro
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Bloqueia qualquer outro acesso não especificado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
